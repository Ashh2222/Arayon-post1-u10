{
  "info": {
    "name": "API Catálogo de Productos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "productoId", "value": "" }
  ],
  "item": [
    {
      "name": "1. POST crear producto",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\":\"Teclado mecánico\",\"precio\":120.0,\"categoria\":\"ELECTRONICA\"}"
        },
        "url": "{{baseUrl}}/api/productos"
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test(\"Status 201 Created\", () => { pm.response.to.have.status(201); });",
          "pm.test(\"Respuesta contiene id numérico\", () => {",
          "  const b = pm.response.json();",
          "  pm.expect(b).to.have.property(\"id\");",
          "  pm.collectionVariables.set(\"productoId\", b.id);",
          "});",
          "pm.test(\"Tiempo de respuesta < 500ms\", () => { pm.expect(pm.response.responseTime).to.be.below(500); });"
        ]}
      }]
    },
    {
      "name": "2. GET obtener producto creado",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/productos/{{productoId}}" },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test(\"Status 200 OK\", () => { pm.response.to.have.status(200); });",
          "pm.test(\"El nombre coincide con el creado\", () => { pm.expect(pm.response.json().nombre).to.eql(\"Teclado mecánico\"); });"
        ]}
      }]
    },
    {
      "name": "3. GET listar por categoría",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/productos?categoria=ELECTRONICA" },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test(\"Status 200 OK\", () => { pm.response.to.have.status(200); });",
          "pm.test(\"La lista contiene al menos un producto\", () => { pm.expect(pm.response.json().length).to.be.above(0); });"
        ]}
      }]
    },
    {
      "name": "4. GET producto inexistente (404)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/productos/99999" },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test(\"Status 404 Not Found\", () => { pm.response.to.have.status(404); });"
        ]}
      }]
    },
    {
      "name": "5. PUT actualizar precio",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"precio\":150.0}" },
        "url": "{{baseUrl}}/api/productos/{{productoId}}/precio"
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test(\"Status 200 OK\", () => { pm.response.to.have.status(200); });",
          "pm.test(\"El precio fue actualizado\", () => { pm.expect(pm.response.json().precio).to.eql(150); });"
        ]}
      }]
    }
  ]
}
